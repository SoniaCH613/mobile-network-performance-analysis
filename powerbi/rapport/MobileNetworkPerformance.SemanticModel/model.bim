      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "pCheminCSV",
        "kind": "m",
        "expression": "\"C:\\A_CONFIGURER\\vue_mesures_detaillees.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": []
      }
    ],
    "tables": [
      {
        "name": "vue_mesures_detaillees",
        "lineageTag": "49f811d6-d1d0-4e74-83b6-073b0d80de0a",
